// The Mesh application (comms/host/HostMesh.ns) over the host's LoRa mesh
// node, on a desktop's pretend air with tools/mesh's meshpeer as the other
// node - "Ada", which says hello on the Public channel once it hears
// someone and answers each message to it with "echo: <text>": its icon in
// the Extras drawer; Ada heard and her channel message filed under the
// Public channel; a conversation begun with her from New, the message
// acknowledged ('delivered) and her echo filed beside it; on the Public
// channel, Send doing nothing with only spaces to send, the reply line
// growing with a long message and emptied by Send (typed text too), a
// message to everyone ('sent); the "i" button's Prefs (only Prefs
// offered), its slip retuning the radio (a preset, then a frequency typed) and renaming the node; each screen
// snapshotted
// (mesh-<width>x<height>-<n>.pgm).  The ctests host.NewtonMesh.<size>:
//
//   python tools/mesh/meshrun.py \
//       --peer "build/host/hal/meshpeer --air lan:{port} --name Ada --echo --channel 'Hello mesh' --seconds 200" \
//       -- build/host/host/newton --mesh-air lan:{port} --display 240x320 --erase \
//       --store mesh.store --headless 150 --script src/host/demo/mesh.ns

HostInclude("common.ns");
meFailures := 0;
meApp := nil;
meShot := 0;
meAda := nil;

meCheck := func(what, ok, why) begin
	if ok then
		Print("mesh: " & what & " ok")
	else begin
		Print("mesh: " & what & " FAILED - " & why);
		meFailures := meFailures + 1;
	end;
end;

meSnap := func() begin
	if meApp then meApp:Dirty();
	RefreshViews();
	local p := GetAppParams();
	meShot := meShot + 1;
	ScreenSnapshot("mesh-" & NumberStr(p.appAreaWidth + p.appAreaLeft) & "x"
		& NumberStr(p.appAreaHeight + p.appAreaTop) & "-" & NumberStr(meShot) & ".pgm");
end;

meEntries := func() begin
	local items := [];
	local soup := GetUnionSoup("Mesh:host");
	if soup then begin
		local cursor := Query(soup, {type: 'index});
		local e;
		while e := cursor:Entry() do begin
			AddArraySlot(items, e);
			cursor:Next();
		end;
	end;
	items;
end;

meEntryWith := func(text) begin
	foreach e in call meEntries with () do
		if StrEqual(e.text, text) then
			return e;
	nil;
end;

meNode := func(name) begin
	local nodes := HostMeshContacts();
	if nodes then
		foreach n in nodes do
			if StrEqual(n.name, name) then
				return n;
	nil;
end;

meIconThere := func() begin
	local cursor := Query(GetUnionSoup(@307.name), {type: 'index});
	local e;
	while e := cursor:Entry() do begin
		if e.app = '|Mesh:host| then
			return e._tagList and SetContains(e._tagList, '_icon);
		cursor:Next();
	end;
	nil;
end;

meSteps := [
	// (a fresh store's Setup assistant closed first)
	func(next) begin
		local start := Ticks();
		local poll;
		poll := func() begin
			if GetRoot().setup and GetRoot().setup.viewCObject then begin
				GetRoot().setup:Close();
				AddDelayedCall(next, nil, 500);
			end else if Ticks() - start > 20 * 60 then
				call next with ()
			else
				AddDelayedCall(poll, nil, 250);
		end;
		call poll with ();
	end,
	func(next) call waitFor with ("mesh: the application",
		func() GetRoot().|Mesh:host| and HostMeshStatus().state = 'on, next, 90),
	func(next) begin
		meApp := GetRoot().|Mesh:host|;
		call meCheck with ("its icon in the Extras drawer", call meIconThere with (), "none");
		meApp:Open();
		call meCheck with ("the Public channel listed first", meApp.threads and Length(meApp.threads) >= 1
			and StrEqual(meApp.threads[0].thread, "public"), "the list is " & (if meApp.threads then Length(meApp.threads)));
		call meSnap with ();
		// Ada hears this node's first advert, says hello on the channel
		call waitFor with ("mesh: Ada and her hello", func() (call meNode with ("Ada"))
			and call meEntryWith with ("Hello mesh"), next, 60);
	end,
	func(next) begin
		meAda := call meNode with ("Ada");
		local hello := call meEntryWith with ("Hello mesh");
		call meCheck with ("Ada's hello on the Public channel", hello and StrEqual(hello.thread, "public")
			and StrEqual(hello.sender, "Ada") and hello.dir = 'incoming,
			"it is " & (if hello then hello.thread & " from " & hello.sender));
		call meCheck with ("unread", hello and hello.state = 'unread, "it is " & (if hello then hello.state));
		call meCheck with ("Ada a chat node", meAda.kind = 'chat, "she is " & meAda.kind);
		call meSnap with ();
		// New: the nodes heard; Ada chosen
		meApp:Compose();
		local index := 0;
		foreach i, n in meApp.pickNodes do
			if StrEqual(n.name, "Ada") then index := i;
		meApp:pickActionScript(index);
		call meCheck with ("a conversation with Ada", meApp.mode = 'thread and StrEqual(meApp.currentThread, meAda.key),
			"the mode is " & meApp.mode);
		call meCheck with ("the tab's title Ada", StrPos(meApp.folderTab.showBarText.text, "Ada", 0),
			"it is " & meApp.folderTab.showBarText.text);
		SetValue(meApp.replyLine.entryLine, 'text, "Hi Ada - are you on the hill tonight?");
		meApp.sendButton:buttonClickScript();
		call waitFor with ("mesh: the message delivered and echoed", func() begin
			local e := call meEntryWith with ("Hi Ada - are you on the hill tonight?");
			e and e.state = 'delivered and call meEntryWith with ("echo: Hi Ada - are you on the hill tonight?");
		end, next, 60);
	end,
	func(next) begin
		local sent := call meEntryWith with ("Hi Ada - are you on the hill tonight?");
		local echo := call meEntryWith with ("echo: Hi Ada - are you on the hill tonight?");
		call meCheck with ("the message in Ada's conversation", sent and sent.dir = 'outgoing
			and StrEqual(sent.thread, meAda.key), "it is " & (if sent then sent.thread));
		call meCheck with ("her echo beside it, read", echo and StrEqual(echo.thread, meAda.key) and echo.state = 'read
			and StrEqual(echo.name, "Ada"), "it is " & (if echo then echo.state));
		call meSnap with ();
		// the Public channel: a message to everyone
		meApp:OpenThread("public");
		// Send with nothing (or only spaces) to send does nothing
		local count := Length(call meEntries with ());
		SetValue(meApp.replyLine.entryLine, 'text, Clone("   "));
		meApp.sendButton:buttonClickScript();
		call meCheck with ("Send with only spaces does nothing", Length(call meEntries with ()) = count,
			Length(call meEntries with ()) - count & " sent");
		// the reply line grows with a long message
		local oneLine := meApp.replyLine:LocalBox().bottom;
		SetValue(meApp.replyLine.entryLine, 'text, Clone("A message long enough to wrap onto several lines of the reply area, which grows to fit it"));
		call meCheck with ("the reply line grown", meApp.replyLines > 1 and meApp.replyLine:LocalBox().bottom > oneLine,
			"it is " & meApp.replyLines & " lines");
		meApp.sendButton:buttonClickScript();
		call meCheck with ("the reply line emptied and one line again", StrLen(meApp.replyLine.entryLine.text) = 0
			and meApp.replyLine:LocalBox().bottom = oneLine, "it is \"" & meApp.replyLine.entryLine.text & "\"");
		// typed (the line's string changed in place), sent, emptied again
		SetKeyView(meApp.replyLine.entryLine, 0);
		PostKeyString(meApp.replyLine.entryLine, "Hello everyone");
		meApp.sendButton:buttonClickScript();
		call meCheck with ("the line emptied after a typed message", StrLen(meApp.replyLine.entryLine.text) = 0,
			"it is \"" & meApp.replyLine.entryLine.text & "\"");
		call waitFor with ("mesh: the channel message sent", func() begin
			local e := call meEntryWith with ("Hello everyone");
			e and e.state = 'sent;
		end, next, 30);
	end,
	func(next) begin
		local hello := call meEntryWith with ("Hello mesh");
		call meCheck with ("Ada's hello read once the channel was opened", hello and hello.state = 'read,
			"it is " & (if hello then hello.state));
		call meSnap with ();
		meApp:ShowList();
		call meSnap with ();
		// the "i" button's Prefs: only Prefs offered; the slip showing the
		// name and the radio's preset (the community's "Australia (Narrow)"
		// by default); a preset filling the settings in, a frequency typed
		// making them "Custom", a new name - all taken on closing
		local info := meApp.statusBar:ChildViewFrames()[0];
		local items := info:GenInfoItems([]);
		call meCheck with ("the i button offering Prefs", Length(items) = 1 and items[0].msg = 'DoInfoPrefs,
			"it offers " & Length(items));
		local hostItem := nil;
		foreach s in HostSettingsList() do
			if s.setting = 'meshRegion then hostItem := s;
		call meCheck with ("the radio no longer a Host setting", not hostItem, "it is there");
		meApp:DoInfoPrefs();
		local slip := meApp.prefsSlip;
		call meCheck with ("the Prefs slip", slip and StrEqual(slip.nameLine.entryLine.text, HostMeshStatus().name)
			and StrEqual(slip.presetPicker.entryLine.text, "Australia (Narrow)")
			and StrEqual(slip.frequencyLine.entryLine.text, "916.575"),
			"it is " & (if slip then slip.presetPicker.entryLine.text & " " & slip.frequencyLine.entryLine.text else "missing"));
		call meSnap with ();
		local australia := nil;
		foreach i, n in HostMeshRegions() do
			if StrEqual(n, "Australia") then australia := i;
		slip.presetPicker:LabelActionScript(australia);
		call meCheck with ("a preset filling the settings in", StrEqual(slip.frequencyLine.entryLine.text, "915.8")
			and StrEqual(slip.bandwidthPicker.entryLine.text, "250 kHz") and StrEqual(slip.spreadingPicker.entryLine.text, "10"),
			"they are " & slip.frequencyLine.entryLine.text & " " & slip.bandwidthPicker.entryLine.text);
		SetValue(slip.frequencyLine.entryLine, 'text, Clone("917.125"));
		call meCheck with ("a frequency typed: Custom", StrEqual(slip.presetPicker.entryLine.text, "Custom"),
			"it is " & slip.presetPicker.entryLine.text);
		SetValue(slip.nameLine.entryLine, 'text, Clone("Pocket Newton"));
		slip:Close();
		call meCheck with ("the slip closed", not meApp.prefsSlip, "it is still open");
		call waitFor with ("mesh: retuned and renamed", func() StrEqual(HostMeshStatus().region, "Custom")
			and StrEqual(HostMeshStatus().name, "Pocket Newton"), next, 10);
	end,
	func(next) begin
		local radio := HostMeshRadio();
		call meCheck with ("retuned to 917.125 MHz, 250 kHz, SF 10", Abs(radio.frequency - 917.125) < 0.0005
			and radio.bandwidth = 250 and radio.spreadingFactor = 10 and not HostMeshRegion(),
			"it is " & radio.frequency & " " & radio.bandwidth & " " & radio.spreadingFactor);
		// a frequency the radio cannot take: told, and left as it was
		meApp:DoInfoPrefs();
		SetValue(meApp.prefsSlip.frequencyLine.entryLine, 'text, Clone("1200"));
		meApp.prefsSlip:Close();
		call meCheck with ("1200 MHz not taken", Abs(HostMeshRadio().frequency - 917.125) < 0.0005,
			"it is " & HostMeshRadio().frequency);
		foreach i, n in HostMeshRegions() do
			if StrEqual(n, "Australia (Narrow)") then HostMeshSetRegion(i);
		Print("mesh: done, " & meFailures & " failed");
		HostQuit();
	end];

meStep := 0;
meNext := func() begin
	local step := meSteps[meStep];
	meStep := meStep + 1;
	call step with (meNext);
end;

call meNext with ();
