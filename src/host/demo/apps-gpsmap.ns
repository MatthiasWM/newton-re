// GPS Map 2.1 (fixtures/packages/apps/GPSMap2.1), Gerd Staudenmaier's
// moving map: scanned maps, routes and NAV points, a track recorded, and
// the receiver's sentences read by its own NMEA 183 driver (an
// asynchronous serial endpoint, its native ARM code on src/armcpu here).
// It opens on the receiver's status - the satellites, track, position,
// altitude and speed - saying it has no map for the place; the host's
// receiver (hal/host/HostGPS.h) stands in Melbourne, is moved to
// Greenwich and set going east at 5 knots.  ctest host.NewtonAppGPSMap:
//
//   build/host/host/newton --display 320x480 --erase --store tmp/gpsmap.store \
//       --headless 280 --gps fixed:-37.8136,144.9631,31 \
//       --package fixtures/packages/apps/GPSMap2.1/GPS_Map21.pkg \
//       --script src/host/demo/apps-gpsmap.ns

HostInclude("common.ns");			// tapAt, typeKey, waitFor, walkSetup
HostInclude("walkhelpers.ns");		// findView, viewWithText, the steps
HostInclude("apphelpers.ns");		// openFromExtras, tapButtonText
HostInclude("gpshelpers.ns");		// gpsShowsStep, gpsMoveStep

wtName := "gpsmap";
gpSym := '|GPS Map:GESTAUD|;

wtIndex := 0;
wtSteps := [
	call gpsPluggedStep with ('nmea),
	func(done) call openFromExtras with ("GPS Map", gpSym, done),
	call gpsShowsStep with (gpSym, "Melbourne from the receiver", ["GPS	: 8", "48.816' S", "57.786' E", "ALT	: 31 m"]),
	call shotStep with ("gpsmap-1"),
	call gpsMoveStep with (51.4779, -0.0015, 46, 0, 0),
	call gpsShowsStep with (gpSym, "moved to Greenwich", ["28.674' N", "0.090' W", "ALT	: 46 m"]),
	call gpsMoveStep with (51.4779, -0.0015, 46, 5, 90),
	call gpsShowsStep with (gpSym, "going east at 5 knots", ["SPD	: 9 km/h", "TRK	: 90"]),
	call shotStep with ("gpsmap-2"),
	func(done) begin
		Print("gpsmap: done, " & wtFailures & " failed");
		HostQuit();
	end];

call walkSetup with ([2, 0, 45, 34, 14, 37], func()			// "Daniel"
	call waitFor with ("gpsmap: installed", func() GetRoot().(gpSym), wtNext, 60));
