@@ 0x448dc5
func() begin
	local l1;
	l1 := true;
	// DEVIATION: not asked when the screen is upright already (orientation
	//  2, what it would be turned to): there turning changes nothing and
	//  the application opens as it would after OK - on a screen smaller
	//  than any MessagePad's (the T-Deck Pro's 240x320), the question was
	//  asked at every open and its OK rebuilt the display for nothing.  An
	//  MP2x00 upright has room, so is never asked.
	if (if (if (if (displayParams.appAreaHeight < 320) then (GetOrientation() <> 2)) then (not self.ReOrientToScreen)) then (self._parent = GetRoot())) then begin
			if (l1 := ModalConfirm("This cannot operate in this orientation.  Should the screen be rotated before opening?", nil)) then begin
					SetScreenOrientation(2)
				end
		end;
	(if l1 then self:_Open())
end
@@end
