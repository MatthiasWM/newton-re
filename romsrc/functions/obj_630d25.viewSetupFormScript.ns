@@ 0x49a359
func() begin
	local l1, l2;
	if ((l1 := self:Parent()) = GetRoot()) then begin
			l2 := GetAppParams().appAreaWidth
		end else begin
			l2 := l1:LocalBox().right
		end;
	if (l2 > 339) then begin
			saveBounds := bigBounds
		end else begin
			// DEVIATION: on a screen narrower than the small keyboard (255:
			//  the T-Deck Pro's 240), a keyboard as wide as the screen - its
			//  keys made smaller to fit (TKeyboardView::Constructor), not cut
			//  off at both sides.  A MessagePad's screen is never so narrow.
			if (l2 < smallBounds.right) then begin
					saveBounds := {left: 0, top: smallBounds.top, right: l2, bottom: smallBounds.bottom}
				end else if (l2 < 282) then begin
					saveBounds := smallBounds
				end else begin
					RemoveSlot(self, 'saveBounds)
				end
		end;
	inherited:viewSetupFormScript()
end
@@end
