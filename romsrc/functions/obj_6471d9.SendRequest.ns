@@ 0x5357d9
func(a1) begin
	local l1;
	if (a1.cause = 'submit) then begin
			return nil
		end;
	if currentItem then begin
			if (status = 'RingingFrom) then begin
					self:SetStatus(status, nil);
					dismissCall := nil;
					self:EventIncoming();
					return nil
				end else begin
					self:ItemCompleted(currentItem, nil, nil)
				end
		end;
	if ((currentItem := self:ItemRequest(a1)).serviceProvider = nil) then begin
			currentItem.startTime := TimeInSeconds();
			status := 'DialingDoneTo;
			return nil
		end;
	l1 := GetDataDefs('|nameRef.phone|):GetRoutingInfo(currentItem.toRef[0])[0];
	currentItem.numberToDial := l1.phoneNumber;
	// DEVIATION (host addition): a provider whose config says dialsAsWritten
	//  - the host's cellular one (comms/host/HostCell.ns) - is given the
	//  number as the card has it, not as the worksite's dialling rules make
	//  it: a mobile network takes "0412 345 678" or "+61 412 345 678" as
	//  they are, and the rules - a landline's area code and a card's
	//  country - turned an Australian mobile number into a local call
	//  stripped of its "04", or an international call to the US
	//  (docs/host-tdeck-pro-phone.md).  Other providers dial as the ROM does.
	local dialProvider := GetTAPICommFrame(currentItem.serviceProvider);
	if dialProvider and dialProvider.config and dialProvider.config.dialsAsWritten then
		currentItem.numberToDial := l1.rawNumber;
	manualStatus := currentItem.saveAsLog;
	(try begin
			self:SetTransportProvider(currentItem.serviceProvider);
			if (not callEndpoint) then begin
					self:InstallEndpoint(transportProvider, true)
				end;
			(if (if transportProvider.config.outgoingNeededDelay then StrFilled(currentItem.numberToDial)) then begin
					abortCall := nil;
					self:DelayDialing(transportProvider.config.outgoingNeededDelay)
				end else self:FinishDialing())
		end onexception |evt.ex| do begin
			(if self:HandleThrow() then self:Shutdown())
		end)
end
@@end
