@@ 0x1017785
func() begin
	self.viewBounds := Clone(self.viewBounds);
	if (if HasSlot(self, 'LabelOnSide) then LabelOnSide) then begin
			self.viewBounds := SetBounds((labelText.viewBounds.right + 3), labelText.viewBounds.top, viewBounds.right, 24)
		end else begin
			self.viewBounds := RelBounds(0, (labelText.viewBounds.bottom + 3), 0, 24)
		end;
	inherited:?viewSetupFormScript()
end
@@end
