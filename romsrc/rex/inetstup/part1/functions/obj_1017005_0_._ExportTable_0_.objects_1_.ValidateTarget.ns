@@ 0x101a001
func(a1) begin
	if (Length(a1.DNSServers) > 1) then begin
			(foreach l1, l2 in a1.DNSServers do begin
					if (Length(SetDifference(l2, [Array: 0, 0, 0, 0])) = 0) then begin
							ArrayRemoveCount(a1.DNSServers, l1, 1)
						end
				end);
			if (Length(a1.DNSServers) = 0) then begin
					AddArraySlot(a1.DNSServers, Clone([Array: 0, 0, 0, 0]))
				end
		end;
	a1
end
@@end
