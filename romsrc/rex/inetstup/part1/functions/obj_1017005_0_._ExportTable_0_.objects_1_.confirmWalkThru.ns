@@ 0x101a119
func(a1) begin
	l1 := "";
	l2 := [Array: ];
	local l1;
	local l2;
	local l3;
	(foreach l4, l5 in DontCloseSlots do begin
			if HasSlot(l5, 'checkData) then begin
					l3 := l5:checkData(a1, a1.(l4))
				end else begin
					if HasSlot(l5, 'checkFunc) then begin
							l3 := l5:checkFunc(a1.(l4))
						end else begin
							l3 := StrEqual(l5.value, a1.(l4))
						end
				end;
			if l3 then begin
					AddArraySlot(l2, l5.name)
				end
		end);
	(foreach l7 in l2 do begin
			l1 := Stringer([Array: l1, l7, ", "])
		end);
	(l1 := Substr(l1, 0, (StrLen(l1) - 2)))
end
@@end
