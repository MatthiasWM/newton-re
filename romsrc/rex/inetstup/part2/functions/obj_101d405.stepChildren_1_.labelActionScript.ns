@@ 0x101d641
func(a1) begin
	local l1;
	inherited:?labelActionScript(a1);
	if IsReadOnly((l1 := GetDataDefs('|Ethernet:NIE|)).newEntryViews) then begin
			l1.newEntryViews := Clone(l1.newEntryViews)
		end;
	if (labelCommands[a1].symbol = 'manual) then begin
			l1.newEntryViews := l1._proto.newEntryViews
		end else begin
			l1.newEntryViews := l1.AlternateNewViews
		end;
	SetValue(newtAppbase.editSlipLayout, 'viewBounds, newtAppbase.editSlipLayout._proto.viewBounds);
	newtAppbase.editSlipLayout:SyncView();
	newtAppbase.editSlipLayout:RedoChildren()
end
@@end
