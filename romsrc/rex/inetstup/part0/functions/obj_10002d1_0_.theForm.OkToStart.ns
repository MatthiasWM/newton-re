@@ 0x1015ca1
@@const kLiteral_1002399
"Internet Setup"
@@const kLiteral_1015e69
"You cannot use Internet Setup because there are no module packages installed."
@@main
func() begin
	l1 := true;
	if (not functions.InetGetService) then begin
			GetRoot():Notify(3, kLiteral_1002399, "You cannot use Internet Setup because the Newton Internet Enabler package is not installed.");
			return nil
		end;
	if (Length((l2 := GetDefs('dataDef, [Array: 'INET], nil))) > 0) then begin
			local l1;
			local l2;
			(foreach l3 in l2 do begin
					if l3:?DependenciesLoaded() then begin
							return true
						end
				end);
			GetRoot():Notify(3, kLiteral_1002399, kLiteral_1015e69);
			return nil
		end else begin
			GetRoot():Notify(3, kLiteral_1002399, kLiteral_1015e69);
			return nil
		end;
	l1
end
@@end
