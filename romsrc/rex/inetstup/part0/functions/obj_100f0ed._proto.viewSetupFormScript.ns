@@ 0x100f249
func() begin
	local l1, l2, l3;
	l1 := GetDataDefs(target.class):StringExtract(target, 1);
	if (if GetVariable(self, 'selectedLayout) then (selectedLayout <> 'default)) then begin
			if (l3 := GetViewDefs(target.class).(selectedLayout)) then begin
					l2 := (if l3.nameByClass then l3.nameByClass.(target.class) else l3.name)
				end
		end;
	if (base.selectedLayout = 'walkThru) then begin
			self.title := ParamStr("^0 ^1  Page ^2 of ^3", [Array: l1, l2, NumberStr((newtAppBase.WhichPage + 1)), NumberStr(Length(GetDataDefs(base.target.class).newEntryViews))])
		end else begin
			if l2 then begin
					self.title := ParamStr("^0 ^1", [Array: l1, l2])
				end else begin
					self.title := ParamStr("^0", [Array: l1])
				end
		end;
	self.titleIcon := GetDataDefs(target.class).overviewIcon;
	inherited:?viewSetupFormScript()
end
@@end
