@@ 0x10134bd
func() begin
	popup := [Array: ];
	statArray := [Array: ];
	l1 := [Array: ];
	l2 := [Array: ];
	if HasSlot(GetGlobals(), 'LinkTemplateRegistry) then begin
			local l1;
			local l2;
			(foreach l3, l4 in LinkTemplateRegistry do begin
					if ((if HasSlot(l4, 'generic) then l4.generic) or BeginsWith(l4.setupName, "Generic")) then begin
							BInsert(l2, {item: l4.setupName, symbol: l3, dataDef: (if HasSlot(l4, 'physicalLayer) then l4.physicalLayer else '|Modem:NIE|)}, '|str<|, '[pathExpr: item], nil)
						end else begin
							BInsert(l1, {item: l4.setupName, symbol: l3, dataDef: (if HasSlot(l4, 'physicalLayer) then l4.physicalLayer else '|Modem:NIE|)}, '|str<|, '[pathExpr: item], nil)
						end
				end);
			if (Length(l1) > 0) then begin
					ArrayMunger(popup, 0, 0, l1, 0, nil);
					ArrayInsert(popup, 'pickSeparator, 0)
				end;
			if (Length(l2) > 0) then begin
					ArrayMunger(popup, 0, 0, l2, 0, nil);
					ArrayInsert(popup, 'pickSeparator, 0)
				end
		end;
	ArrayInsert(popup, '{item: "Generic Setup", symbol: Blank, dataDef: newEntry}, 0);
	(statArray := popup)
end
@@end
