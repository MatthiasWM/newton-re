@@ 0x10111ad
func() begin
	local l1, l2, l3;
	l1 := GetDataDefs(target.class);
	l2 := true;
	if (selectedLayout = 'walkThru) then begin
			if (if (l3 := l1:?ConfirmWalkThru(target)) then StrFilled(l3)) then begin
					l2 := ModalConfirm(ParamStr("This setup is missing information in the ^0 field(s) and may not function properly. Are you sure you want to close?", [Array: l3]), 'okCancelDefaultCancel)
				end
		end;
	(if l2 then begin
			target := l1:?ValidateTarget(target);
			if (appBase.editSlipLayout = base) then begin
					appBase.editSlipLayout := nil
				end;
			newtAppBase.WhichPage := 0;
			AddDeferredSend(appBase, 'RememberedClose, [Array: base])
		end)
end
@@end
