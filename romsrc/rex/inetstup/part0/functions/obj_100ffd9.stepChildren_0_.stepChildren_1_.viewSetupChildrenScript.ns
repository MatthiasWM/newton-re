@@ 0x10108d9
func() begin
	local l1, l2, l3, l4, l5;
	l1 := viewChildren[0];
	stepChildren := Clone(stepChildren);
	if (selectedLayout = 'walkThru) then begin
			if IsReadOnly((l3 := GetDataDefs(target.class)).newEntryViews) then begin
					l3.newEntryViews := Clone(l3.newEntryViews)
				end;
			if (target.configuration = 'manual) then begin
					l3.newEntryViews := l3._proto.newEntryViews
				end else begin
					if (if l3.AlternateNewViews then (Length(l3.AlternateNewViews) > 0)) then begin
							l3.newEntryViews := l3.AlternateNewViews
						end else begin
							l3.newEntryViews := l3._proto.newEntryViews
						end
				end;
			l4 := Length(l3.newEntryViews);
			if (newtAppBase.WhichPage = 0) then begin
					ArrayMunger(stepChildren, 4, 1, nil, 0, nil)
				end;
			if (newtAppBase.WhichPage = (l4 - 1)) then begin
					ArrayMunger(stepChildren, 3, 1, nil, 0, nil);
					ArrayMunger(stepChildren, 1, 1, nil, 0, nil)
				end else begin
					ArrayMunger(stepChildren, 2, 1, nil, 0, nil)
				end
		end else begin
			ArrayMunger(stepChildren, 2, 3, nil, 0, nil)
		end;
	l5 := KeyboardConnected();
	if (if l1.usePhoneKeys then (not l5)) then begin
			stepChildren[0] := {_proto: @676, viewJustify: 144, viewBounds: SetBounds(0, (-126 - extraChildrenHeight), 124, (-extraChildrenHeight))}
		end else begin
			if (if l1.useNumericKeys then (not l5)) then begin
					stepChildren[0] := {_proto: @376, viewJustify: 144, viewBounds: SetBounds(0, (-101 - extraChildrenHeight), 105, (-extraChildrenHeight)), viewFont: keypadFont}
				end else begin
					if (l1.noKeyboard or l5) then begin
							ArrayMunger(stepChildren, 0, 1, nil, 0, nil)
						end else nil
				end
		end;
	if (not l1.noKeyboard) then begin
			l2 := stepChildren[0].viewBounds;
			extraChildrenHeight := ((extraChildrenHeight + l2.bottom) - l2.top)
		end;
	inherited:?viewSetupChildrenScript()
end
@@end
