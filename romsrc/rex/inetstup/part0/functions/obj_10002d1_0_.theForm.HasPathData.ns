@@ 0x100e229
func(a1, a2, a3) begin
	if IsArray(a2) then begin
			(foreach l1 in a2 do begin
					if a1.(l1) then begin
							if (a3 or IsInstance(a1.(l1), 'string)) then begin
									return StrFilled(a1.(l1))
								end else begin
									return true
								end
						end
				end)
		end else begin
			if a1.(a2) then begin
					return true
				end
		end;
	nil
end
@@end
