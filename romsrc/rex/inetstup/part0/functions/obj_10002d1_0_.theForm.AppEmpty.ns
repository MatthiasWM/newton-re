	l1.right := (l1.right - 10);
	l1.top := ((l1.bottom - l1.top) div 3);
	(appEmptyStr := [Array: '{font: 1058816, justification: left}, MakeTextLines(ParamStr("No current ^0 exists. To create a new ^0, tap New and in the pop-up list, tap a choice\u2014\uGeneric Setup, SecurID, UNIX, or an Internet Service Provider (ISP).", [Array: title]), l1, fontHeight(1058816), 1058816)])
end
