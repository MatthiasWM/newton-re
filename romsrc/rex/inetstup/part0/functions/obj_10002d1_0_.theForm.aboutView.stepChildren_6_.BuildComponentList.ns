@@ 0x1016519
func() begin
	local theList;
	theList := "";
	if functions.InetGetServiceList then begin
			map(InetGetServiceList('physicalService), func(a1, a2) begin
				(theList := Stringer([Array: theList, Clone(a2.name), ", "]))
			end)
		end;
	if functions.InetGetServiceList then begin
			map(InetGetServiceList('logicalService), func(a1, a2) begin
				(theList := Stringer([Array: theList, Clone(a2.name), ", "]))
			end)
		end;
	Substr(theList, 0, (StrLen(theList) - 2))
end
@@end
