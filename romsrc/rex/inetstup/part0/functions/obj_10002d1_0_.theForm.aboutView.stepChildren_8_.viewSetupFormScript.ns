@@ 0x1016871
func() begin
	l1 := 0;
	l2 := 0;
	local l1;
	local l2;
	(foreach l3 in theSoups do begin
			local l5;
			l5 := l3:Query(nil);
			l2 := (l2 + l5:CountEntries());
			l1 := (l1 + l3:GetSize())
		end);
	if (l1 > 0) then begin
			l1 := max((l1 div 1024), 1);
			text := Stringer([Array: text, (if (l2 = 0) then ParamStr("\n^0K storage used", [Array: l1]) else (if (l2 = 1) then ParamStr("\n^0K storage used for 1 ^1", [Array: l1, theApp.appObject[0]]) else ParamStr("\n^0K storage used for ^1 ^2", [Array: l1, l2, theApp.appObject[1]])))])
		end;
	inherited:?viewSetupFormScript()
end
@@end
