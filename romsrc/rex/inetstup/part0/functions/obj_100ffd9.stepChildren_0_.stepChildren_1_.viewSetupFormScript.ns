@@ 0x1010329
func() begin
	local l1;
	if (if (if selectedLayout then target) then GetViewDefs(target.class).(selectedLayout)) then begin
			self.viewDef := selectedLayout
		end else begin
			self.viewDef := 'default
		end;
	if (ClassOf(selectedPath) = 'pathExpr) then begin
			self.path := selectedPath
		end;
	inherited:?viewSetupFormScript();
	(if (selectedLayout = 'walkThru) then begin
			l1 := GetDataDefs(target.class);
			l1:?SetupViews(target);
			header:Retarget();
			viewChildren := [Array: l1.newEntryViews[newtAppBase.WhichPage]];
			(base.verifyFunc := l1.newEntryViews[newtAppBase.WhichPage].verifyFunc)
		end)
end
@@end
