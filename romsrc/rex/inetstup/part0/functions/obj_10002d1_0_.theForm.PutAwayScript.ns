@@ 0x1015a85
func(a1) begin
	local l1, l2, l3;
	if (a1.appSymbol = '|InternetSetup:Newton|) then begin
			if (not a1.body.physicalLayer) then begin
					a1.body.physicalLayer := 'Modem
				end;
			a1.body.physicalLayer := '{serial: |Serial:NIE|, Modem: |Modem:NIE|, MacIP: |LocalTalk:NIE|, ethernet: |Ethernet:NIE|}.(a1.body.physicalLayer);
			a1.body.class := a1.body.physicalLayer;
			if (if (l2 := GetDataDefs(a1.body.physicalLayer)) then ((not HasSlot(a1.body, 'version)) or (a1.body.version < 2))) then begin
					a1.body := l2:?DataConversion(a1.body)
				end;
			l1 := true
		end;
	(l3 := inherited:?PutAwayScript(a1)).linkID := (if functions.InetStartUp then InetStartUp():MGetLinkUniqueID() else Random(0, 10000));
	if l1 then begin
			EntryUndoChanges(a1)
		end;
	l3
end
@@end
