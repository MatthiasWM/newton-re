@@ 0x1014d91
func() begin
	local l1, l2;
	(if (if target then target.class) then begin
			if (not layouts) then begin
					layouts := {}
				end;
			if (not layouts.(target.class)) then begin
					layouts.(target.class) := call GetRoot().|InternetSetup:NIE|.GetViewsToDisplay with (target)
				end;
			(if (GetVariable(self, 'newtAppBase) <> GetRoot().|InternetSetup:NIE|) then (self.viewFlags := 1))
		end)
end
@@end
