obj_1004fc9 := {data: "Choose one of the following:\u000d• Ethernet to connect to an Ethernet network for Internet access\u000d• LocalTalk to use a LocalTalk cable to connect to an AppleTalk network bridged to a TCP/IP network and a MacIP server\u000d• Modem to use a Newton-compatible modem to connect to the Internet\u000d• Serial to use a serial cable to connect to a computer that’s connected to the Internet\u000d", styles: [|Array|: 31, obj_100533d, 8, obj_1004f15, 57, obj_100533d, 9, obj_1004f15, 110, obj_100533d, 5, obj_1004f15, 63, obj_100533d, 6, obj_1004f15, 82, obj_100533d]};
obj_100533d := {family: 'espy, face: 0, size: 10};
obj_1005355 := {data: "Know what I need", viewFont: obj_1004f15, layout: 32, name: "know"};
obj_10053b9 := {data: "You can connect to the Internet using Ethernet, LocalTalk, modem, or serial connections.\u000dYou’ll need:\u000d• an account with an Internet Service Provider (ISP) or one set up through work or school, or access to a private company intranet\u000d• one or more Internet applications for your Newton device\u000d", viewFont: obj_100533d};
obj_100563d := {data: "Get started using Ethernet", viewFont: obj_1004f15, layout: 32, name: "gse"};
obj_10056b1 := {data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• an Ethernet PC card compatible with your Newton device\u000d• an Ethernet network\u000d", viewFont: obj_100533d};
obj_1005819 := {data: "Get started using AppleTalk", viewFont: obj_1004f15, layout: 32, name: "gsat"};
obj_1005891 := {data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• a LocalTalk cable connected to an AppleTalk network bridged to a TCP/IP network and a Mac IP server\u000dOR\u000d•an Ethernet PC card connected to an EtherTalk network bridged to a TCP/IP network and a Mac IP server\u000d", viewFont: obj_100533d};
obj_1005af9 := {data: "Get started using a modem", viewFont: obj_1004f15, layout: 32, name: "gsm"};
obj_1005b69 := {data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• an analog phone line or cellular telephone\u000d• an external modem or PC card modem compatible with your Newton device\u000d• a setup file for your modem \u000dSetups for some modems are included with your Newton device. Check with your modem manufacturer for more information.\u000d", viewFont: obj_100533d};
obj_1005e45 := {data: "Get started using a serial connection", viewFont: obj_1004f15, layout: 32, name: "gss"};
obj_1005ecd := {data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• a serial cable to connect your Newton device to a computer connected to the Internet\u000d", viewFont: obj_100533d};
obj_1006045 := {data: "Gather information", viewFont: obj_1004f15, layout: 32, name: "gather"};
obj_10060b1 := {data: "Get the necessary information from your ISP or network administrator: \u000d• IP addresses for your Newton device and your gateway, or router\u000d• a domain name\u000dYou may also need:\u000d• the subnet mask\u000d• your user ID and password\u000d• access telephone numbers\u000d• which link protocol to use—PPP or SLIP\u000d• an ISP template\u000d• steps in the login or logout script\u000d", viewFont: obj_100533d};
obj_1006381 := {data: "Create an Internet Setup\u000d", layout: 2080, name: "create"};
obj_10063f5 := {data: "Create a new Internet setup", viewFont: obj_1004f15, layout: 32, name: "new"};
obj_1006469 := {data: "An Internet setup is a collection of information you need to connect to the Internet via a network or an ISP. To create an Internet setup, you use a template—Generic Setup, SecurID, UNIX, or your ISP.\u000d1. Tap New.\u000d2. In the pop-up list, tap the desired template.\u000d", viewFont: obj_100533d};
obj_1006699 := {data: "Using Ethernet\u000d", layout: 2080, name: "ethernet"};
obj_10066fd := {data: obj_1006719, viewFont: obj_1004f15, layout: 32, name: "ethernet1"};
obj_1006719 := "Enter Information on Slip 1";
obj_100677d := {data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Configuration—Manual or DHCP Server\u000d• Card—the type of Ethernet PC card you’re using\u000d", viewFont: obj_100533d};
obj_10068e5 := {data: obj_1006901, viewFont: obj_1004f15, layout: 32, name: "ethernet2"};
obj_1006901 := "Enter Information on Slip 2";
obj_1006965 := {data: "• Local IP Address—a numeric address for your Newton device\u000d• Subnet Mask—identifies the subnetwork\u000d• Gateway/Router Address—a numeric address for the gateway that directs information to/from your Newton device\u000d• Primary DNS/Name Server Address— identifies the computer that contains a list of IP addresses and their associated names\u000d• Domain Name—an alphabetic address for the network you’re connected to\u000d", viewFont: obj_100533d};
obj_1006cb5 := {data: "Using LocalTalk\u000d ", layout: 2080, name: "atalk"};
obj_1006d15 := {data: obj_1006719, viewFont: obj_1004f15, layout: 32, name: "atalk1"};
obj_1006d4d := {data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Configuration—Manual or MacIP Server\u000d• Zone—the AppleTalk zone that contains the MacIP server (or router) you are connecting to\u000d", viewFont: obj_100533d};
obj_1006f09 := {data: obj_1006901, viewFont: obj_1004f15, layout: 32, name: obj_1006f25};
obj_1006f25 := "enterinfo";
obj_1006f45 := {data: "• Local IP Address—a numeric address for your Newton device \u000d• Gateway/Router Address—a numeric address for the gateway that directs information to/from your Newton device\u000d• Primary DNS/Name Server Address— identifies the computer that contains a list of IP addresses and associated names\u000d• Domain Name—an alphabetic address for the network you’re connected to\u000d", viewFont: obj_100533d};
obj_1007239 := {data: "Using a modem", layout: 2080, name: "modem"};
obj_1007291 := {data: obj_1006719, viewFont: obj_1004f15, layout: 32, name: "modem1"};
obj_10072c9 := {data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Protocol—Point-to-Point or Serial Line Interface Protocol\u000d• Configuration—Manual or Server\u000d• Access Number—the telephone number you use to connect\u000d• User ID—your user or login name\u000d• Set/Edit Password—your user password\u000d• When closing, disconnect—the time until the connection is dropped after you close an Internet application\u000d ", viewFont: obj_100533d};
obj_1007619 := {data: obj_1006901, viewFont: obj_1004f15, layout: 32, name: obj_1006f25};
obj_1007635 := {data: obj_1007649, viewFont: obj_100533d};
obj_1007649 := "• Local IP Address—a numeric address for your Newton device\u000d• Gateway/Router Address—a numeric address for the gateway that directs information to/from your Newton device\u000d• Primary DNS/Name Server Address— identifies the computer that contains a list of IP addresses and associated names\u000d• Domain Name—an alphabetic address for the network you’re connected to\u000d";
obj_1007929 := {data: "Add or edit modem settings", viewFont: obj_1004f15, layout: 32, name: obj_1007989};
obj_1007989 := "modemsettings";
obj_10079b1 := {data: "1. Go to the desired setup.\u000d2. Do one of the following:\u000d• Tap Add, then tap Modem Settings.\u000d• Tap Modem Settings.\u000d3. Enter settings for your modem. See the documentation that came with your modem or contact your modem manufacturer.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_1007be5 := {data: "Using a serial connection\u000d", layout: 2080, name: "serial"};
obj_1007c5d := {data: obj_1006719, viewFont: obj_1004f15, layout: 32, name: "serial1"};
obj_1007c95 := {data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Protocol—Point-to-Point or Serial Line Interface Protocol\u000d• Configuration—Manual or Server\u000d• User ID—your user or login name\u000d• Set/Edit Password—your user password\u000d• When closing, disconnect—the time until the connection is dropped after you close an Internet application\u000d", viewFont: obj_100533d};
obj_1007f71 := {data: obj_1006901, viewFont: obj_1004f15, layout: 32, name: obj_1006f25};
obj_1007f8d := {data: obj_1007649, viewFont: obj_100533d};
obj_1007fa1 := {data: "Add Information to a Setup\u000d", layout: 2080, name: "add"};
obj_1008011 := {data: "Add information", viewFont: obj_1004f15, layout: 32, name: "addinfo"};
obj_1008075 := {data: "You can add information to an existing setup. \u000d1. Go to the desired setup.\u000d2. Tap Add and in the pop-up list, tap your choice.\u000d3. In the slip, enter the new information.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100822d := {data: "Add alternate access numbers", viewFont: obj_1004f15, layout: 32, name: "accessno"};
obj_10082b1 := {data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Alternate Access Number.\u000d3. Enter the number.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_10083d1 := {data: "Add DNS/Name server addresses", viewFont: obj_1004f15, layout: 32, name: obj_1008435};
obj_1008435 := "dns";
obj_1008449 := {data: "1. Go to the desired setup.\u000d2. Tap Add, then tap DNS/Name Server Address.\u000d3. Enter the address.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100856d := {data: "Add a login/logout script\u000d", styles: [|Array|: 26, obj_1004f15, 1, obj_100533d], layout: 32, name: "script"};
obj_1008625 := {data: "Determine the script steps", viewFont: obj_1004f15, layout: 32, name: "steps"};
obj_100869d := {data: "If your ISP doesn’t use PAP or CHAP authentication, you need to enter a login script. You may also need a logout script.\u000d\u000dTo determine the steps for scripts, contact your ISP. Or, use a terminal emulator program on your Newton device or your computer to log into the host, noting the steps you take to log in and log out. \u000d", viewFont: obj_100533d};
obj_1008945 := {data: "Create a login/logout script", viewFont: obj_1004f15, layout: 32, name: "addscript"};
obj_10089c9 := {data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Login Script or Logout Script.\u000d3. Tap Done, then tap the first command. \u000d4. Continue choosing commands until the script is completed. Leave the final “Done.”\u000d5. Tap Timeout, then tap your choice.\u000d6. If you want, tap the checkbox next to “Display script activity.”\u000d", viewFont: obj_100533d};
obj_1008c5d := {data: "Add modem settings", viewFont: obj_1004f15, layout: 32, name: obj_1007989};
obj_1008cad := {data: "You can add modem settings to a particular Internet setup. When you use this setup, it overrides the modem settings in Prefs.\u000d1. Go to the desired setup.\u000d2. Tap Add, then tap Modem Settings.\u000d3. Enter the appropriate settings. \u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_1008ed5 := {data: "Add a disconnect delay", viewFont: obj_1004f15, layout: 32, name: "discodelay"};
obj_1008f51 := {data: "You can set a disconnect delay if you want to wait a specified time before disconnecting from the Internet, after you close Internet applications.\u000d1. Go to the desired setup.\u000d2. Tap Add, then tap Disconnect Delay.\u000d3. Tap “When closing, disconnect,” then tap your choice.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_10091d1 := {data: "Add advanced serial settings", viewFont: obj_1004f15, layout: 32, name: "advanced"};
obj_1009255 := {data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Advanced Settings.\u000d3. Enter settings, then tap X.\u000d• Port—the port or card slot you’re using \u000d• Data Rate—speed of data transfer\u000d• Parity—error detection that appends a bit to each data byte\u000d• Stop Bits—one or more bits that signal the end of a byte\u000d• Use Hardware Flow Control—hardware signals that control data flow\u000d", viewFont: obj_100533d};
obj_1009555 := {data: "Add redial settings", viewFont: obj_1004f15, layout: 32, name: "redial"};
obj_10095c1 := {data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Redial Settings.\u000d3. Enter your settings, then tap X.\u000d• Redial—specifies access numbers to redial\u000d• Try to redial—sets the number of times you want to redial \u000d• Wait before redialing—specifies the time before redialing\u000d", viewFont: obj_100533d};
obj_10097f9 := {data: "Add the country of my ISP", viewFont: obj_1004f15, layout: 32, name: "country"};
obj_1009871 := {data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Country.\u000d3. Do one of the following:\u000d• Enter the country.\u000d• Tap Country, then tap the scroll arrows or tap a lettered tab to move through the list. Tap your country, then tap X. \u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_1009a9d := {data: "Change Information\u000d", layout: 2080, name: "edit"};
obj_1009b01 := {data: "Change information in a setup ", viewFont: obj_1004f15, layout: 32, name: "editing"};
obj_1009b85 := {data: "1. Go to the setup you want to change.\u000d2. Tap the item you want to edit.\u000d3. In the slip, enter the information.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_1009cc9 := {data: "Change my configuration ", viewFont: obj_1004f15, layout: 32, name: "configuration"};
obj_1009d4d := {data: "The configuration tells your Newton device how you are going to connect—manually, using information you enter, or via a server, which allows the server to send the settings.\u000d1. Go to the setup you want to change.\u000d2. Tap Configuration.\u000d3. Tap Configuration again, then tap your choice.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_1009fe9 := {data: "Change the subnet mask", viewFont: obj_1004f15, layout: 32, name: "subnet"};
obj_100a05d := {data: "The subnet mask is a numeric address that identifies the subnetwork your device is connected to.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap Subnet Mask.\u000d3. Enter the new subnet mask.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100a235 := {data: "Change the local IP address", viewFont: obj_1004f15, layout: 32, name: "ipaddress"};
obj_100a2b5 := {data: "The local IP address is a numeric address that identifies your Newton device.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap Local IP Address.\u000d3. Enter the new address.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100a469 := {data: "Change the gateway/router address ", viewFont: obj_1004f15, layout: 32, name: "gateway"};
obj_100a4f5 := {data: "The gateway, or router, address is a numeric address that identifies the gateway that directs information to and from your Newton device.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap Gateway/Router Address.\u000d3. Enter the new address.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100a72d := {data: "Change the name server addresses", viewFont: obj_1004f15, layout: 32, name: obj_1008435};
obj_100a799 := {data: "The DNS (Domain Name System)/Name server address identifies the computer that contains a list of IP addresses and names associated with those numeric addresses.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap the address you want to edit.\u000d3. Enter the new address.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100aa0d := {data: "Change the domain name", viewFont: obj_1004f15, layout: 32, name: "domain"};
obj_100aa81 := {data: "The domain name is an alphabetic Internet address for the network you’re connected to.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap the domain name you want to edit.\u000d3. Enter the address.\u000d4. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100ac61 := {data: "Change my user ID or password", viewFont: obj_1004f15, layout: 32, name: "idpassword"};
obj_100ace9 := {data: "Your user ID, also called your login name, and your password are provided by your ISP or network administrator.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap User ID.\u000d3. If necessary, enter your new user ID.\u000d4. If necessary, tap Set/Edit Password. Enter your password, press or tap the Tab key, then enter the password again. When you’re ready, tap Set.\u000d5. Tap X to close the slip.\u000d", viewFont: obj_100533d};
obj_100b009 := {data: "Working with Internet Setups\u000d", layout: 2080, name: "use"};
obj_100b07d := {data: "View Internet setups ", viewFont: obj_1004f15, layout: 32, name: "view"};
obj_100b0e9 := {data: "From the Overview:\u000d1. Tap the name of the setup you want to view.\u000d2. Tap X to return to the Overview.\u000d\u000dFrom an Internet setup:\u000d• To view the summary slip, tap or press the Scroll Up/Scroll Down arrows or keys.\u000d• To see a list of all your setups, tap or press Overview.\u000d", viewFont: obj_100533d};
obj_100b325 := {data: "Add an Internet setup to a worksite", viewFont: obj_1004f15, layout: 32, name: "worksite"};
obj_100b3b5 := {data: "1. Tap or press Extras, tap the folder tab, then tap All Icons.\u000d2. Tap Owner Info, then tap a worksite.\u000d3. Tap Add, then tap Internet Access.\u000d4. Tap Internet Setup, then tap a setup. \u000d5. Tap X to close the slip.\u000d6. Tap Show, then tap All Info. The selected setup should appear.\u000d7. When you’re finished, tap X.\u000d", viewFont: obj_100533d};
obj_100b645 := {data: "Store an Internet setup on a PC card", viewFont: obj_1004f15, layout: 32, name: "store"};
obj_100b6d1 := {data: "Before you create your Internet setup:\u000d1. Tap the i button in the lower-left corner, then tap Prefs.\u000d2. Make sure the checkbox “Always store new setups internally” is not checked. \u000d3. Insert a PC storage card, then create your Internet setup.\u000d", viewFont: obj_100533d};
obj_100b8d9 := {data: "Move an Internet setup", viewFont: obj_1004f15, layout: 32, name: "move"};
obj_100b949 := {data: "1. Go to the desired setup.\u000d2. Tap the Folder button. \u000d3. Do one of the following:\u000d•To store the setup in the internal memory, tap Internal.\u000d• To store the setup on a card, tap the card’s name.\u000d4. Tap File.\u000d", viewFont: obj_100533d};
obj_100bb09 := {data: "Send an Internet setup", viewFont: obj_1004f15, layout: 32, name: "send"};
obj_100bb79 := {data: "You can fax, beam, or mail Internet setups to other Newton devices.\u000d1. Go to the desired setup.\u000d2. Tap the Routing button.\u000d3. In the pop-up list, tap your choice.\u000d• If you’re beaming, make sure the infrared windows of the two Newton devices are aligned and within three feet or each other.\u000d• If you’re printing or mailing, enter information in the routing slip, then tap Fax or Mail. In the pop-up list, tap Now or Later.\u000d", viewFont: obj_100533d};
obj_100bee9 := {data: "Delete an Internet setup", viewFont: obj_1004f15, layout: 32, name: "delete"};
obj_100bf61 := {data: "From the Overview:\u000d1. Tap the checkbox next to each setup you want to delete.\u000d2. Tap the Routing button, then tap Delete.\u000d3. When the message appears asking if you want to delete, tap OK.\u000d\u000dFrom an Internet setup:\u000d1. Tap the Routing button, then tap Delete.\u000d2. When the message appears asking if you want to delete, tap OK.\u000d", viewFont: obj_100533d};
obj_100c209 := {data: "Connect and Disconnect\u000d", layout: 2080, name: "connect"};
obj_100c279 := {data: "Connect to the Internet", viewFont: obj_1004f15, layout: 32, name: "connectinternet"};
obj_100c2fd := {data: "1. Create an Internet setup.\u000d2. Start your Internet application. \u000dA connection slip appears. You can\u000d• use the default Internet setup \u000d• select a different Internet setup\u000d• switch to a different worksite\u000d3. Choose the settings you want, then tap Connect.\u000d", viewFont: obj_100533d};
obj_100c51d := {data: "Disconnect from the Internet", viewFont: obj_1004f15, layout: 32, name: "disconnect"};
obj_100c5a5 := {data: "• Close any Internet applications that are open.\u000d\u000dIf you want to set a time delay, see the subtopic “Add a Disconnect Delay” under the topic “Add Information to a Setup.”\u000d\u000dIf you set a time delay and want to disconnect before this time, see the subtopic “Override the Disconnect Delay.”\u000d", viewFont: obj_100533d};
obj_100c805 := {data: "Override the disconnect delay", viewFont: obj_1004f15, layout: 32, name: "override"};
obj_100c889 := {data: "If you specified a time delay before disconnecting and closed all Internet application before this time, a blinking star appears at the top of the screen.  \u000d\u000dTo disconnect sooner than the time delay:\u000d1. Tap the blinking star, then tap Internet.\u000d2. In the slip that appears, tap OK.\u000d", viewFont: obj_100533d};
obj_100d125 := {nColumns: 1, column: [|Array|: {width: 12, type: 0}]};
obj_100d3c5 := [|Array|: 0, 0, 206, 14];
obj_100d3f5 := [|Array|: 0, 14, 206, 214];
obj_100d58d := [|Array|: 0, 0, 206, 28];
obj_100d5bd := [|Array|: 0, 28, 206, 214];
