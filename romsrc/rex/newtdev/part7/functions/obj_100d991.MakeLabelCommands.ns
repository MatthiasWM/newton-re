@@ 0x100dd39
func() begin
	items := [Array: ];
	if DeviceRegistry then begin
			(foreach l1, l2 in DeviceRegistry do begin
					if (if (l2.DeviceClass = curLinkSym) then l2.AppleTalkAvailable) then begin
							if IsArray(l2.DeviceDisplayName) then begin
									(foreach l4, l5 in l2.DeviceDisplayName do begin
											BInsert(items, {item: l2.DeviceDisplayName[l4], choiceSym: l1, CISName: l2.DeviceCISProductName[l4]}, '|str<|, 'item, true)
										end)
								end else begin
									BInsert(items, {item: l2.DeviceDisplayName, choiceSym: l1, CISName: l2.DeviceCISProductName}, '|str<|, 'item, true)
								end
						end
				end)
		end;
	items
end
@@end
