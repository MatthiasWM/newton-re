@@ 0x100db2d
func(a1) begin
	l1 := nil;
	if (if labelCommands then a1) then begin
			local l1;
			(foreach l2, l3 in labelCommands do begin
					if StrEqual(l3.CISName, a1) then begin
							l1 := l2
						end
				end)
		end;
	(if l1 then return labelCommands[l1].item else (if (Length(labelCommands) = 1) then begin
				curDevice := labelCommands[0].CISName;
				return labelCommands[0].item
			end else return "None Selected"))
end
@@end
