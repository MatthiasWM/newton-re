@@ 0x1013579
func() begin
	local l1, l2, l3;
	l1 := viewChildren[0];
	stepChildren := Clone(stepChildren);
	l3 := KeyboardConnected();
	if (if l1.usePhoneKeys then (not l3)) then begin
			stepChildren[0] := {_proto: @676, viewJustify: 144, viewBounds: SetBounds(0, (-126 - extraChildrenHeight), 124, (-extraChildrenHeight))}
		end else begin
			if (if l1.useNumericKeys then (not l3)) then begin
					stepChildren[0] := {_proto: @376, viewJustify: 144, viewBounds: SetBounds(0, (-101 - extraChildrenHeight), 105, (-extraChildrenHeight)), viewFont: keypadFont}
				end else begin
					if (l1.noKeyboard or l3) then begin
							ArrayMunger(stepChildren, 0, 1, nil, 0, nil)
						end else begin
							if knoAlphaKeyboard then begin
									ArrayMunger(stepChildren, 0, 1, nil, 0, nil);
									AddArraySlot(stepChildren, keyButton)
								end
						end
				end
		end;
	if (not l1.noKeyboard) then begin
			l2 := stepChildren[0].viewBounds;
			extraChildrenHeight := ((extraChildrenHeight + l2.bottom) - l2.top)
		end;
	inherited:?viewSetupChildrenScript()
end
@@end
