@@ 0x10144c9
func() begin
	if ((not device.AppleTalkAvailable) or (not PrefsRegistry.AppleTalk)) then begin
			viewFlags := 0
		end;
	originalATLink := GetUserConfig('appletalkLink);
	if (not (originalATDevice := GetUserConfig('AppleTalkChoice))) then begin
			SetUserConfig('AppleTalkChoice, Clone(""));
			originalATDevice := Clone("")
		end;
	if StrEqual(originalATLink, "pnet") then begin
			if StrEqual(cisName, originalATDevice) then begin
					viewValue := true
				end
		end;
	inherited:?viewSetupFormScript()
end
@@end
