@@ 0x1011565
@@const kROM_8193
@8193
@@const kLiteral_1011391
"Lantern"
@@main
func(a1) begin
	if IsArray((l1 := Clone(DeviceRegistry.(a1).DeviceCISProductName))) then begin
			local l1;
			(foreach l2, l3 in l1 do begin
					call kROM_8193 with (Clone(l1[l2]), Clone(kLiteral_1011391), nil)
				end)
		end else begin
			call kROM_8193 with (Clone(l1), Clone(kLiteral_1011391), nil)
		end;
	if (l5 := GetUserConfig('AppleTalkChoice)) then begin
			l6 := nil;
			if IsArray(l1) then begin
					(foreach l2, l3 in l1 do begin
							local l5, l6;
							if StrEqual(l5, l1[l2]) then begin
									l6 := true;
									break
								end
						end)
				end else begin
					if StrEqual(l5, l1) then begin
							l6 := true
						end
				end;
			if l6 then begin
					SetUserConfig('appletalkLink, "llap");
					SetUserConfig('AppleTalkChoice, nil);
					LoadHardwareEntry();
					call kROM_8193 with (Clone("ATalk"), Clone("enet"), nil)
				end
		end;
	RemoveSlot(GetRoot(), Intern(DeviceRegistry.(a1).DeviceType));
	UnRegDataView('worksite, a1);
	RemoveSlot(DeviceRegistry, a1);
	if (Length(DeviceRegistry) = 0) then begin
			MarkPackageNotBusy(ObjectPkgRef('void))
		end;
	nil
end
@@end
