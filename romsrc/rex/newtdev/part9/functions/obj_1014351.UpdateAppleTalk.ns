@@main
func(a1, a2) begin
	(if ((if ((not StrEqual(a1, GetUserConfig('appletalkLink))) or (not StrEqual(GetUserConfig('AppleTalkChoice), a2))) then StrFilled(a2)) or StrEqual(a1, "llap")) then begin
			SetUserConfig('appletalkLink, Clone(a1));
			SetUserConfig('AppleTalkChoice, Clone(a2));
			LoadHardwareEntry();
			(if StrEqual(a1, "llap") then call kROM_8193 with (Clone(kLiteral_10117f9), Clone(kLiteral_1011811), nil) else call kROM_8192 with (Clone(kLiteral_10117f9), Clone(kLiteral_1011811), Clone(a2), nil))
		end)
end
@@end
