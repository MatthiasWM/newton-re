@@ 0x1007309
func(a1) begin
	local l1;
	(try begin
			l1 := nil;
			if _Clients then begin
					l1 := AddArraySlot(_Clients, a1)
				end else begin
					_Clients := [Array: a1];
					l1 := a1
				end;
			a1._Device := self;
			return l1
		end onexception |evt.ex| do begin
			return CurrentException().error
		end)
end
@@end
