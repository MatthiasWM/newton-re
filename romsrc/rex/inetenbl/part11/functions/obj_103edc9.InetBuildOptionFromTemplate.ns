@@ 0x104ccd5
func(a1, a2) begin
	local l1;
	l1 := (if IsFrame(a1) then TotalClone(a1) else {});
	if IsFrame(a2) then begin
			if HasPath(a2, 'label) then begin
					l1.label := a2.label
				end;
			if HasPath(a2, 'type) then begin
					l1.type := a2.type
				end;
			if HasPath(a2, 'opCode) then begin
					l1.opCode := a2.opCode
				end;
			if HasPath(a2, 'result) then begin
					l1.result := a2.result
				end;
			if HasPath(a2, 'form) then begin
					l1.form := a2.form
				end;
			if (l1.form = 'template) then begin
					if (if HasPath(a2, 'data) then HasPath(l1, 'data)) then begin
							if HasPath(a2, 'data.arglist) then begin
									l1.data.arglist := a2.data.arglist
								end;
							if HasPath(a2, 'data.typeList) then begin
									l1.data.typeList := a2.data.typeList
								end
						end
				end
		end;
	TotalClone(l1)
end
@@end
