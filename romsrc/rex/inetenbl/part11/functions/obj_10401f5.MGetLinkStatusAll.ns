@@ 0x1046b55
func() begin
	local l1, l2, l3, l4;
	l1 := {linkIds: [Array: ], statuses: [Array: ], names: [Array: ]};
	try begin
			l3 := (l2 := self:MGetLinkCursor()):entry();
			(while l3 do begin
					AddArraySlot(l1.linkIds, l3.linkID);
					AddArraySlot(l1.statuses, self:MGetLinkStatus(l3.linkID));
					AddArraySlot(l1.names, l3.setupName);
					(l3 := l2:Next())
				end)
		end onexception |evt.ex| do begin
			l4 := Length(l1.linkIds);
			SetLength(l1.linkIds, l4);
			SetLength(l1.statuses, l4);
			SetLength(l1.names, l4);
			l1.incomplete := true
		end;
	l1
end
