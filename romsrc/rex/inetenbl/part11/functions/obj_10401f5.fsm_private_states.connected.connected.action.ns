@@ 0x1049b25
func() begin
	self:MUpdateProgressSlip('Update, nil, 100);
	(foreach l1 in fLinkClients_Grab do begin
			if (not l1.fFrame.isRegistered) then begin
					fDumbLinkClientsExist := true;
					break
				end
		end);
	fLinkStatus := 'connected;
	self:MUpdateProgressSlip('Close, nil, nil);
	(foreach l1 in fLinkClients do begin
			self:MDoCallback(l1, [Array: fLinkEntry.linkID, self:MBuildStatusFrame(fLinkEntry.linkID, fLinkStatus, nil, nil, nil, nil)])
		end);
	self:MDoCallbacks(fLinkClients_Grab, self:MBuildStatusFrameFromError(nil), 'Reset);
	(foreach l1 in fLinkClients_ReleasePending do begin
			self:DoEvent('RemoveLinkClient, l1)
		end);
	SetLength(fLinkClients_ReleasePending, 0)
end
@@end
