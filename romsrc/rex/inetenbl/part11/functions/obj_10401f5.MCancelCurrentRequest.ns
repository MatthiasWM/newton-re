@@ 0x1040d49
func(a1) begin
	local l1;
	l1 := (if a1 then a1 else self:MGetLinkDefaultID());
	(if (if fLinkEntry then (fLinkEntry.linkID = l1)) then begin
			self:DoEvent('Cancel, nil);
			if fDomainServiceFSM then begin
					fDomainServiceFSM:DoEvent('Cancel, nil)
				end;
			(if fScriptServiceFSM then fScriptServiceFSM:DoEvent('Cancel, nil))
		end)
end
@@end
