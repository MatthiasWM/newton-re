@@ 0x10485f1
func() begin
	self:MUpdateProgressSlip('Update, nil, 40);
	if ((not IsFrame(fLinkEntry.loginScript)) or (not (fScriptServiceFSM := InetGetService(fLinkEntry.loginScript.interpreterSymbol)))) then begin
			return self:DoEvent('ParseLoginScriptSkipped, nil)
		end;
	fLinkStatus := 'login;
	fScriptServiceFSM := fScriptServiceFSM:InstantiateAndPerform(nil, 'Create, nil);
	fScriptServiceFSM:DoEvent('SetCCE, [Array: fCCE]);
	fScriptServiceFSM:DoEvent('SetLinkEntry, [Array: fLinkEntry]);
	fScriptServiceFSM:DoEvent('SetCommsFSM, [Array: fPhysicalLayerServiceFSM]);
	fScriptServiceFSM:DoEvent('SetScript, [Array: fLinkEntry.loginScript]);
	fScriptServiceFSM:DoEvent('Parse, [Array: self, 'MParseCallback])
end
@@end
