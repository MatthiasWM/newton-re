func(a1) begin
	(foreach l1 in fLinkClients_Release do begin
			self:MDoCallback(l1, [Array: l1.fLinkID, a1, a1.infoError])
		end);
	(if a1.infoError then begin
			SetClass(fLinkClients_Release, 'error);
			self:DoEvent('DisconnectLinkFailure, nil)
		end else (if (a1.infoStatus = 'disconnected) then self:DoEvent('DisconnectLinkSuccess, nil)))
end
