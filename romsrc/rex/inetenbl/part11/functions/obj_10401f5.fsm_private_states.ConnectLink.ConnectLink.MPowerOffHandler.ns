@@ 0x1049399
func(a1, why) begin
	local StartRelease;
	local l1;
	l1 := InetStartUp();
	StartRelease := func() begin
		InetStartUp().fWhyLinkDropped := why;
		InetStartUp():DoEvent('Cancel, nil)
	end;
	if (a1 = 'okToPowerOff) then begin
			if (if (why = 'user) then (l1.fLinkStatus <> 'idle)) then begin
					if l1.fNotifyIconObj then begin
							call StartRelease with ()
						end else begin
							if (not l1.fPowerOffSlipVisible) then begin
									l1.fPowerOffSlipVisible := true;
									AsyncConfirm("Before you can safely power off, you must close all applications currently connected to the Internet. Do you want to power off anyway?", 'yesNo, func(a1) begin
										InetStartUp().fPowerOffSlipVisible := nil;
										(if a1 then call StartRelease with ())
									end)
								end
						end;
					return nil
				end else begin
					if ((why <> 'idle) or (l1.fLinkStatus = 'idle)) then begin
							return true
						end
				end
		end else begin
			if (a1 = 'PowerOff) then begin
					if ((why <> 'idle) or (l1.fLinkStatus <> 'idle)) then begin
							l1.fPowerOffState := 'holdYourHorses;
							l1.fWhyLinkDropped := why;
							l1:DoEvent('Cancel, nil);
							return 'holdYourHorses
						end
				end
		end;
	nil
end
@@end
