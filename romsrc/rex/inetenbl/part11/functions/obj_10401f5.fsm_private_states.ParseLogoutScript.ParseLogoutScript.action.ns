@@ 0x1047ab9
func() begin
	self:MUpdateProgressSlip('Update, nil, 60);
	if ((not IsFrame(fLinkEntry.logoutScript)) or (not (fScriptServiceFSM := InetGetService(fLinkEntry.logoutScript.interpreterSymbol)))) then begin
			return self:DoEvent('ParseLogoutScriptSkipped, nil)
		end;
	fLinkStatus := 'logout;
	fScriptServiceFSM := fScriptServiceFSM:InstantiateAndPerform(nil, 'Create, nil);
	fScriptServiceFSM:DoEvent('SetCCE, [Array: fCCE]);
	fScriptServiceFSM:DoEvent('SetLinkEntry, [Array: fLinkEntry]);
	fScriptServiceFSM:DoEvent('SetCommsFSM, [Array: fPhysicalLayerServiceFSM]);
	fScriptServiceFSM:DoEvent('SetScript, [Array: fLinkEntry.logoutScript]);
	fScriptServiceFSM:DoEvent('Parse, [Array: self, 'MParseCallback])
end
@@end
