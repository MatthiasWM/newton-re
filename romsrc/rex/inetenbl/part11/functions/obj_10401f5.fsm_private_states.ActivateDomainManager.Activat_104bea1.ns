@@ 0x104bea1
func() begin
	self:MUpdateProgressSlip('Update, nil, 90);
	if (not (fDomainServiceFSM := InetGetService(GetUserConfig('NIE_DefaultDomainManager)))) then begin
			if (not (fDomainServiceFSM := InetGetService('|Domain Manager:NIE|))) then begin
					return self:DoEvent('ActivateDomainManagerSkipped, nil)
				end
		end;
	fDomainServiceFSM := fDomainServiceFSM:InstantiateAndPerform(nil, 'Create, nil);
	fDomainServiceFSM:DoEvent('SetCCE, [Array: fCCE]);
	fDomainServiceFSM:DoEvent('SetLinkEntry, [Array: fLinkEntry]);
	fDomainServiceFSM:DoEvent('connect, [Array: self, 'MActivateDomainManagerCallback])
end
@@end
