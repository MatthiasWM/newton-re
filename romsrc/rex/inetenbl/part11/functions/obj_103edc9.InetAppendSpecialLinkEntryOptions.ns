@@ 0x104cbc1
func(a1, a2, a3) begin
	if (if IsFunction(a2.(a3)) then (GetFunctionArgCount(a2.(a3)) = 2)) then begin
			try begin
					call a2.(a3) with (a2, a1)
				end onexception |evt.ex| do begin end
		end;
	(if IsArray(a1) then (if IsFrame(a2.(a3)) then AddArraySlot(a1, a2.(a3)) else (if IsArray(a2.(a3)) then (foreach l1 in a2.(a3) do begin
						if IsFrame(l1) then begin
								AddArraySlot(a1, l1)
							end
					end))))
end
@@end
