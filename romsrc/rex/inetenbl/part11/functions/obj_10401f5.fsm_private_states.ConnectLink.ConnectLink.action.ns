@@ 0x1048eb5
func() begin
	local l1, l2;
	fLinkStatus := 'initializing;
	if fVerboseConnect then begin
			self:MUpdateProgressSlip('Open, "Preparing for connection...", 0)
		end;
	RegPowerOff('|Inet Manager:NIE|, MPowerOffHandler);
	if fAbort then begin
			return self:DoEvent('DoFailure, [Array: -16005])
		end;
	try begin
			l2 := fCCE:Instantiate(fCCE, self:MBuildConfigOptions_InstantiateCCE(fCCE))
		end onexception |evt.ex| do begin
			return self:DoEvent('DoFailure, [Array: self:MGetExceptionError(CurrentException())])
		end;
	fCCE.fActive := true;
	if (if IsArray(l2) then (l1 := InetGetOptionFromOptionArray(l2, "sid "))) then begin
			fProcessPortID := l1.data.arglist[1]
		end;
	if (not (fLinkLayerServiceFSM := InetGetService(fLinkEntry.linkLayer))) then begin
			return self:DoEvent('DoFailure, [Array: -60508])
		end;
	fLinkLayerServiceFSM := fLinkLayerServiceFSM:InstantiateAndPerform(nil, 'Create, nil);
	if (not (fPhysicalLayerServiceFSM := InetGetService(fLinkEntry.physicalLayer))) then begin
			return self:DoEvent('DoFailure, [Array: -60507])
		end;
	fPhysicalLayerServiceFSM := fPhysicalLayerServiceFSM:InstantiateAndPerform(nil, 'Create, nil);
	self:DoEvent('LoadPhysicalLayerDriverProtocol, nil)
end
@@end
