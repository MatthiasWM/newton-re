@@ 0x1048a4d
func() begin
	fLinkStatus := 'disconnecting;
	(foreach l1 in fLinkClients do begin
			self:MDoCallback(l1, [Array: fLinkEntry.linkID, self:MBuildStatusFrame(fLinkEntry.linkID, fLinkStatus, nil, nil, nil, nil)])
		end);
	self:MNotifyIconOff();
	if fVerboseDisconnect then begin
			self:MUpdateProgressSlip('Open, "Disconnecting your internet link...", 0)
		end;
	self:DoEvent('DeactivateDomainManager, nil)
end
@@end
