@@ 0x104c25d
func() begin
	local l1, l2;
	self:MUpdateProgressSlip('Update, "Connecting to the internet...", 60);
	l2 := [Array: ];
	if (if IsArray(fPhysicalLayerServiceFSM:?GetConfigOptionsAfter_Instantiate()) then (l1 := InetGetOptionFromOptionArray(fPhysicalLayerServiceFSM:GetConfigOptionsAfter_Instantiate(), "sid "))) then begin
			AddArraySlot(l2, InetBuildOptionFromTemplate(l1, {type: 'option, opCode: 512}))
		end;
	InetAppendSpecialLinkEntryOptions(l2, fLinkEntry, 'inetAlmostFinalOptions);
	AddArraySlot(l2, {label: "iclc", type: 'option, opCode: 512, result: nil, form: 'template, data: {arglist: [Array: nil, nil, fLinkEntry.linkID, 0, 4], typeList: [Array: 'struct, 'ulong, 'long, 'ulong, 'ulong, 'ulong]}});
	InetAppendSpecialLinkEntryOptions(l2, fLinkEntry, 'inetFinalOptions);
	if (Length(l2) = 0) then begin
			return self:DoEvent('ActivateCCESuccess, nil)
		end;
	(try begin
			fCCE:option(l2, self:MBuildCompletionSpec_Option())
		end onexception |evt.ex| do begin
			self:DoEvent('ActivateCCEFailure, [Array: InetGetExceptionError(CurrentException())])
		end)
end
@@end
