func() begin
	try begin
			if (unique = 'unique) then begin
					fsm:DoUniqueEvent(event, params)
				end else begin
					fsm:DoEvent(event, params)
				end
		end onexception |evt.ex| do begin end;
	(try begin
			(if ((occurrences := (occurrences - 1)) > 0) then delay)
		end onexception |evt.ex| do begin
			nil
		end)
end
