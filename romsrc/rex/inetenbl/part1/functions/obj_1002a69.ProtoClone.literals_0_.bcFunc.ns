@@ 0x1013531 argframe=0,0
func(a1) begin
	if ((not IsFrame(a1)) or IsFunction(a1)) then begin
			Throw('|evt.ex.msg|, "ProtoClone only works with frames.")
		end;
	l1 := {_proto: a1};
	local l1;
	(foreach l2, l3 in a1 do begin
			if (if IsFrame(l3) then (not IsFunction(l3))) then begin
					l1.(l2) := call f with (l3)
				end
		end);
	l1
end
@@end
