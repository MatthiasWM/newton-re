func() begin
	if (not fsm_private_context) then begin
			return nil
		end;
	fsm_private_context.pendingEventQueue:Reset();
	fsm_private_context.pendingParamsQueue:Reset();
	fsm_private_context.engineView:Close();
	(foreach l1, l2 in fsm_private_context do begin
			fsm_private_context.(l1) := nil
		end);
	fsm := (currentStateFrame := (currentEventFrame := (fsm_private_context := nil)));
	nil
end
