@@ 0x1015929
func(a1, a2, a3) begin
	if (if (if a1 then a2) then a3) then begin
			local l1;
			local l2;
			(foreach l3 in a1 do begin
					if (l2 := l3.(a2)) then begin
							if (l2 := l2.(a3)) then begin
									if l1 then begin
											(l2 := Clone(l2))._proto := l1;
											l1 := l2
										end else begin
											l1 := l2
										end
								end
						end
				end)
		end;
	l1
end
@@end
