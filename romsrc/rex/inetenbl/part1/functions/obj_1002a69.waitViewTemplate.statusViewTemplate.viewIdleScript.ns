@@ 0x1013b65
func() begin
	local l1;
	inherited:?viewIdleScript();
	l1 := {name: 'vBarber, values: {barber: true}};
	if delayUntilAbortVisible then begin
			if ((delayUntilAbortTimer := (delayUntilAbortTimer + 300)) > delayUntilAbortVisible) then begin
					delayUntilAbortVisible := nil;
					l1.values.primary := {text: abortButtonText, script: func() begin
						waitView.aborted := true;
						waitView:Close()
					end};
					base:ViewSet(l1);
					return 300
				end
		end;
	base:UpdateIndicator(l1);
	300
end
@@end
