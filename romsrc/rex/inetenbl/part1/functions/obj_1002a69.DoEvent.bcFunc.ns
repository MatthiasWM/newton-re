@@ 0x1011fc9 argframe=nil,0
func(a1, a2) begin
	local l1;
	if (not (l1 := self:?DoEvent_Check('|protoFSM:DoEvent|))) then begin
			return nil
		end;
	l1.pendingEventQueue:EnQueue(a1);
	l1.pendingParamsQueue:EnQueue(a2);
	if (not l1.busy) then begin
			l1.busy := true;
			AddDelayedSend(l1.engineView, 'SetupIdle, [Array: l1.turtle], 1)
		end;
	nil
end
@@end
